#!/bin/sh
# Thin launcher: runs control.py with the project's virtualenv Python.
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY="$PROJECT_DIR/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "Missing $PY. Create it: python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt" >&2
  exit 1
fi
exec "$PY" "$PROJECT_DIR/control.py" "$@"
